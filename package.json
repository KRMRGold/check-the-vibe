{
  "name": "check-the-vibe",
  "productName": "Check the Vibe",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop music collection, deck builder, and music game.",
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test",
    "package:smoke": "electron-forge package",
    "compare:fma": "node scripts/compare-fma.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@playwright/test": "1.65.0",
    "electron": "45.3.2",
    "playwright": "1.65.0"
  }
}
